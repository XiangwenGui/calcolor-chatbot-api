# Dependencies
node_modules/

# Vercel
.vercel

# OS
.DS_Store

# Regenerated eval outputs (the harness rewrites these on every run)
month_test_sim/test_run_log.txt
month_test_sim/test_run_summary.txt
*.out

# Secrets — every .env* is ignored EXCEPT the checked-in template.
# KEEP THIS BLOCK LAST: the negation only works if nothing re-ignores
# .env.example below it. `vercel link` appends its own `.env*` line to the
# end of this file, so if you ever re-run it, move that line above here.
.env*
!.env.example
