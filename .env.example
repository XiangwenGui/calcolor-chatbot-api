# --- Required ---
# OpenRouter API key. Used for BOTH embeddings and generation.
# Create one at: https://openrouter.ai/settings/keys
# Set a per-key monthly spend limit while you're there — that is the control that
# stops a runaway, along with keeping Auto Top-Up OFF on the Credits page.
#
# THIS IS THE ONLY KEY THE CODE READS. There are two keys in the OpenRouter
# account — one for Vercel Production, one for Preview — but nothing reads a
# variable named after an environment. Paste whichever key this machine should
# spend against (normally the preview one) into OPENROUTER_API_KEY below.
# Leaving this empty while the two variables at the bottom are filled in fails
# with "Missing Authentication header", which does not point at the cause.
OPENROUTER_API_KEY=

# --- Optional (sensible defaults in lib/config.ts) ---
# Comma-separated list of origins allowed to call the API (CORS).
# Leave empty for local dev (allows all). Set in production, e.g.:
# ALLOWED_ORIGINS=https://calcolor.com,https://www.calcolor.com
ALLOWED_ORIGINS=

# Model IDs (OpenRouter "provider/model" strings). Swap without code changes.
# Look CHAT_MODEL up at https://openrouter.ai/models before changing it —
# OpenRouter's catalogue is not the same as Vercel AI Gateway's, and if you keep
# REASONING_EFFORT set, the model page must list `reasoning`/`reasoning_effort`
# under supported parameters or the setting is silently ignored.
# EMBED_MODEL is not in that browsable catalogue; it resolves only via
# /api/v1/models/{id}/endpoints. Changing it INVALIDATES data/vectors.json —
# you must re-run `npm run build:index` and re-baseline the eval.
CHAT_MODEL=openai/gpt-5-mini
EMBED_MODEL=openai/text-embedding-3-small

# Reference copies of the two OpenRouter keys, kept here so whoever owns the
# account can see both without opening the dashboard. NEITHER IS READ BY THE
# CODE — they are a note to a human. Copy one into OPENROUTER_API_KEY above to
# actually use it.
OPENROUTER_PREVIEW_API_KEY="YOUR_PREVIEW_API_KEY"
OPENROUTER_PRODUCTION_API_KEY="YOUR_PRODUCTION_API_KEY"

# Retrieval / generation tuning
TOP_K=4
MIN_SCORE=0.3
MAX_OUTPUT_TOKENS=800
# Reasoning effort for GPT-5-family models: none|minimal|low|medium|high|xhigh
# Anything else falls back to 'minimal'.
REASONING_EFFORT=minimal

# Front-desk contact shown in the escalation message
FRONT_DESK_PHONE=(408) 818-8818
FRONT_DESK_EMAIL=cu@calcolor.com
TRIAL_URL=https://calcolor.com/trial.html
