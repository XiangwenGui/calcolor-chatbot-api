{
  "name": "calcolor-chatbot-api",
  "version": "0.1.0",
  "private": true,
  "description": "CalColor Academy customer-facing RAG chatbot API (standalone Vercel service)",
  "type": "module",
  "scripts": {
    "build:index": "node --env-file-if-exists=.env --import tsx scripts/build-index.ts",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.34"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
